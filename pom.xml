<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.0</version>
        <relativePath/>
    </parent>

    <groupId>com.executor</groupId>
    <artifactId>executor-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>executor-parent</name>
    <description>Executor 任务调度引擎 — 父 POM，统一管理子模块依赖版本</description>

    <modules>
        <module>executor-core</module>
        <module>executor-example</module>
        <module>executor-stress</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- 外部依赖版本管理 -->
        <xxl-job-core.version>2.4.0</xxl-job-core.version>
        <rocketmq-spring-boot.version>2.2.3</rocketmq-spring-boot.version>
        <mybatis-spring-boot-starter.version>3.0.3</mybatis-spring-boot-starter.version>
        <mysql-connector-j.version>8.3.0</mysql-connector-j.version>
        <fastjson.version>1.2.83</fastjson.version>
        <quartz.version>2.3.0</quartz.version>
        <executor-sdk.version>1.0.0-SNAPSHOT</executor-sdk.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- executor-sdk（子模块按需引入） -->
            <dependency>
                <groupId>com.executor</groupId>
                <artifactId>executor-sdk</artifactId>
                <version>${executor-sdk.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
